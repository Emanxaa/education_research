# Copy this file to ".env" (already ignored by .gitignore) and point to your local BPS SUSENAS West Java folder.
# Expected layout inside SUSENAS_ROOT: <year>/csv/KOR/*PART1*.csv, KOR/*Rumah Tangga*.csv, Modul KP*/*4.3*.csv
SUSENAS_ROOT=/path/to/SUSENAS/JAWA_BARAT

# Optional overrides:
# MASTER_WILAYAH_PATH=./config/master_wilayah.json
# J2_T1_OUT_DIR=./data
